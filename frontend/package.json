{
  "name": "scih-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest",
    "test:cov": "vitest run --coverage",
    "gen:api": "npx --yes openapi-typescript@7 http://localhost:8000/openapi.json -o src/types/api.ts && prettier --write src/types/api.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-table": "^9.2.4",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "jsdom": "^28.0.2",
    "oxlint": "^1.81.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.0.18"
  }
}
