# Copy to .env and adjust. `make up` works with these values unchanged.
ENV=local
DEBUG=true

# Postgres. POSTGRES_* are consumed by the database container, DATABASE_URL by the app.
POSTGRES_DB=scih
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://app_user:app_password@postgres:5432/scih

REDIS_URL=redis://redis:6379/0

# MinIO speaks the S3 API, so the same client code runs against AWS S3.
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=scih-documents
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Generate with: openssl rand -hex 32
# Any ENV other than local/test refuses to start while this placeholder is in use.
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# pgvector needs no credentials and runs offline. Set pinecone to use the adapter.
VECTOR_BACKEND=pgvector
PINECONE_API_KEY=
PINECONE_INDEX=scih

# mock answers from retrieved context with no network call, which is what CI uses.
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=

CORS_ORIGINS=http://localhost:5173

# Vite bakes these into the bundle, so never put a secret here.
VITE_API_BASE_URL=http://localhost:8000

# Values above are what the containers use. Host tooling (pytest, psql) reaches
# the stack on localhost:55432 and localhost:56379, which is what the defaults in
# app/core/config.py point at. Those are not 5432/6379 because a native postgres
# or redis on the machine would hold the loopback address.
