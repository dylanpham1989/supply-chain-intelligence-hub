# syntax=docker/dockerfile:1.7
FROM python:3.14-slim AS builder

RUN pip install --no-cache-dir uv==0.11.17

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

ARG UV_DEFAULT_INDEX=""
ENV UV_DEFAULT_INDEX=${UV_DEFAULT_INDEX}

WORKDIR /build
COPY backend/pyproject.toml backend/uv.lock ./
# The worker parses documents and embeds them, so it carries the groups the api
# does not. Keeping torch out of the api image is the point of the split.
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv sync --frozen --no-default-groups --group ingest --group ai --no-install-project


FROM python:3.14-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH"

RUN groupadd --gid 10001 app \
 && useradd --uid 10001 --gid app --create-home --shell /usr/sbin/nologin app

COPY --from=builder /opt/venv /opt/venv

# Bake the embedding model in. Downloading it on first use would put a few
# seconds and a network dependency into the first job of every fresh container.
ENV HF_HOME=/models \
    SENTENCE_TRANSFORMERS_HOME=/models
ARG EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RUN --mount=type=cache,target=/root/.cache/huggingface,sharing=locked \
    python -c "from sentence_transformers import SentenceTransformer; \
SentenceTransformer('${EMBEDDING_MODEL}', device='cpu')" \
 && chown -R app:app /models

WORKDIR /app
COPY --chown=app:app backend/ /app/

ARG GIT_SHA=unknown
ENV GIT_SHA=${GIT_SHA}

USER app

# No http server to probe. Ask arq whether the worker is still answering.
HEALTHCHECK --interval=20s --timeout=5s --start-period=20s --retries=3 \
    CMD ["python", "-c", "import asyncio,sys;from arq.connections import RedisSettings,create_pool;from app.core.config import settings;\nasync def m():\n    r=await create_pool(RedisSettings.from_dsn(settings.redis_url));await r.ping();await r.aclose()\ntry:\n    asyncio.run(m())\nexcept Exception:\n    sys.exit(1)"]

CMD ["arq", "worker.settings.WorkerSettings"]
