# syntax=docker/dockerfile:1.7
FROM python:3.12-slim AS builder

RUN pip install --no-cache-dir uv==0.11.17

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# Override to build through a mirror. Empty means pypi.
ARG UV_DEFAULT_INDEX=""
ENV UV_DEFAULT_INDEX=${UV_DEFAULT_INDEX}

WORKDIR /build
COPY backend/pyproject.toml backend/uv.lock ./
# Separate layer so touching source does not reinstall deps. The cache mount
# survives layer invalidation, so changing one dependency downloads one wheel
# rather than all of them.
#
# The ai group is here because answering a question means embedding it, and that
# happens on the read path inside this process. The ingest group is not: parsing
# only ever runs in the worker. Splitting the image further would mean a
# separate embedding service, or an onnx runtime build of the same model, and
# neither is worth the moving parts at this size.
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv sync --frozen --no-default-groups --group ai --no-install-project


FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH"

RUN groupadd --gid 10001 app \
 && useradd --uid 10001 --gid app --create-home --shell /usr/sbin/nologin app

COPY --from=builder /opt/venv /opt/venv

# Same model as the worker, baked in for the same reason: a question should not
# wait on a download.
ENV HF_HOME=/models \
    SENTENCE_TRANSFORMERS_HOME=/models
ARG EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RUN --mount=type=cache,target=/root/.cache/huggingface,sharing=locked \
    python -c "from sentence_transformers import SentenceTransformer; \
SentenceTransformer('${EMBEDDING_MODEL}', device='cpu')" \
 && chown -R app:app /models

WORKDIR /app
COPY --chown=app:app backend/ /app/

ARG GIT_SHA=unknown
ARG BUILT_AT=unknown
ENV GIT_SHA=${GIT_SHA} BUILT_AT=${BUILT_AT}

USER app
EXPOSE 8000

# Liveness, not readiness: a 503 means a dependency is down, which is no reason
# to kill the container. Any HTTP answer counts as alive.
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=5 \
    CMD ["python", "-c", "import sys,urllib.error,urllib.request\ntry:\n    urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2)\nexcept urllib.error.HTTPError:\n    pass\nexcept Exception:\n    sys.exit(1)"]

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
