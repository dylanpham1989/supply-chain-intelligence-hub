# Copy to secret.env before `make kind-deploy`. secret.env is gitignored: it is
# a development credential, but a credential in git is a habit, not an accident.
DATABASE_URL=postgresql+asyncpg://app_user:app_password@postgres:5432/scih
DATABASE_OWNER_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/scih
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=scih-local-access
S3_SECRET_KEY=scih-local-secret-change-me
JWT_SECRET=local-kind-cluster-secret-not-for-anything-else
